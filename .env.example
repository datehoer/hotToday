# Local crawler settings. Use hosts reachable from your runtime/container.
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=hottoday
PG_DB=hotday
PG_PASSWORD=''

# Redis connection (optional for the crawler).
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=''

# Proxy URL used by sources with proxy: subpool.
HOT_PROXY_URL=http://127.0.0.1:6666

# Set your own provider URL/model before supplying API keys; see README.md.
HOT_EMBED_KEY=''
# Optional separate repair key; otherwise repair uses HOT_EMBED_KEY.
HOT_REPAIR_KEY=''
